{
  "name": "@traffic-simulator/engine",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Traffic engine: given a network, a demand and a seed, advances a run step by step. No browser dependencies.",
  "exports": {
    ".": "./src/index.ts",
    "./consistency-checks": "./src/consistency-checks.ts",
    "./examples/*.json": "./examples/*.json"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
